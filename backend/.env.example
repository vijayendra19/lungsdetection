# ==============================================================================
# SMART STETHOSCOPE AI - BACKEND CONFIGURATION
# ==============================================================================

# Application
PROJECT_NAME="Smart Stethoscope AI Backend"
API_V1_STR="/api"
ENVIRONMENT="development"
DEBUG=True

# Database (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Default fallback to sqlite for quick local testing if postgres isn't running
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/smart_stethoscope_db"

# JWT Authentication
# In production, generate a secure random string (e.g. `openssl rand -hex 32`)
JWT_SECRET="steth-ai-super-secret-key-change-in-production-123456789"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Audio & File Upload Storage
UPLOAD_DIR="static/uploads"
HEATMAP_DIR="static/heatmaps"
MAX_UPLOAD_SIZE_MB=25

# CORS Settings (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
